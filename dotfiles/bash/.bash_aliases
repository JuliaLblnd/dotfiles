alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

alias ls='ls -h --color=auto'
alias zshconfig="mate ~/.zshrc"
alias ohmyzsh="mate ~/.oh-my-zsh"
alias bye="cd && exit && exit"
alias back='cd $OLDPWD'
alias e="explorer.exe"
alias e.="explorer.exe ."
alias tracert='tracert.exe'
alias subl="/mnt/c/Program\ Files/Sublime\ Text\ 3/sublime_text.exe"
alias st="subl"
alias go='go.exe'

# 42
alias c='cc -Wall -Wextra -Werror'
alias cps='cp $(ls ~/Downloads/en.subject*.pdf -1dt | head -n1) en.subject.pdf'
alias egrep='grep -E --color=auto'
alias fgrep='grep -F --color=auto'
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit -v'
alias gcf='git config --list'
alias gcl='git clone --recursive'
alias gcm='git commit -m'
alias gcmain='git checkout main'
alias gco='git checkout'
alias gcsm='git commit -s -m'
alias gd='git diff'
alias gds='git diff --staged'
alias gf='git fetch'
alias glg='git log --stat'
alias glgg='git log --graph'
alias gp='git push'
alias grep='grep --color=auto'
alias gst='git status'
alias l='ls -lh'
alias l.='ls -d .* --color=auto'
alias ll='ls -lah'
alias ls='ls --color=auto'
alias n='norminette'
alias n*='norminette *'
alias o='xdg-open "$(git rev-parse --show-toplevel)/en.subject.pdf" > /dev/null 2>&1'
alias rmrv='rm -rf ~/review/*'
alias rv='mkdir -p /goinfre/juleblon/review && rm -rf /goinfre/juleblon/review/* && cd /goinfre/juleblon/review'
alias vi='vim'
alias which='(alias; declare -f) | /usr/bin/which --tty-only --read-alias --read-functions --show-tilde --show-dot'
alias wo='cd "$(ls ~/Documents/* -1dt | head -n1)"'
alias xzegrep='xzegrep --color=auto'
alias xzfgrep='xzfgrep --color=auto'
alias xzgrep='xzgrep --color=auto'
alias zegrep='zegrep --color=auto'
alias zfgrep='zfgrep --color=auto'
